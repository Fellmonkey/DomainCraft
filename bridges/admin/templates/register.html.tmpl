<!doctype html>
<html lang="en">
<head>
  {{ template "head" (printf "Register - %s Admin" (.Project.Name | pascalcase)) }}
</head>
<body class="bg color" style="--bg: var(--z-bg); --color: var(--z-bg-f)">
  <div x-data="{
    {{- range $.Project.Entities }}
    {{- if eq .Name $.Project.Auth.Entity }}
    {{- range .NonRelationFields }}
    {{- if and (not (.IsFeatureField)) (not .IsPrimary) (not .IsHidden) (not .IsArray) (not .IsJson) (ne .Name "email") (ne .Name "password") (ne .Name "Email") (ne .Name "Password") }}
    {{ .Name }}: '{{ .DefaultValue }}',
    {{- end }}{{- end }}
    {{- end }}{{- end }}
    email: '', password: '', confirm: '', agree: false, submitting: false, error: '', success: ''
  }"
    x-init="if ($store.auth.token) location.href = 'index.html'"
    style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--z-bg-muted);">
    <div class="login-card" style="max-width: 440px;">
      <div style="text-align: center; margin-bottom: 2rem;">
        <div style="width: 48px; height: 48px; border-radius: 0.75rem; background: var(--z-primary); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
        </div>
        <h1 style="font-size: 1.5rem; font-weight: 650; letter-spacing: -0.02em; margin: 0 0 0.375rem;">{{ .Project.Name | pascalcase }}</h1>
        <p style="font-size: 0.875rem; color: var(--z-muted-f); margin: 0;">Create admin account</p>
      </div>
      <template x-if="error"><div class="z-alert z-alert-danger" style="margin-bottom: 1.25rem; border-radius: 0.5rem;"><span x-text="error"></span></div></template>
      <template x-if="success"><div class="z-alert z-alert-success" style="margin-bottom: 1.25rem; border-radius: 0.5rem;"><span x-text="success"></span></div></template>
      <form @submit.prevent="
        if (password !== confirm) { error = 'Passwords do not match'; return; }
        submitting = true; error = '';
        (async () => {
          try {
            const body = {
              email: email,
              password: password
            };
            {{- range $.Project.Entities }}
            {{- if eq .Name $.Project.Auth.Entity }}
            {{- range .NonRelationFields }}
            {{- if and (not (.IsFeatureField)) (not .IsPrimary) (not .IsHidden) (not .IsArray) (not .IsJson) (ne .Name "email") (ne .Name "password") (ne .Name "Email") (ne .Name "Password") }}
            {{- if .HasValidation "required" }}
            body['{{ .Name }}'] = {{ .Name }};
            {{- end }}
            {{- end }}{{- end }}
            {{- end }}{{- end }}
            const r = await fetch((window.API_BASE_URL || 'http://{{ .Project.Deploy.Domain }}:{{ .Project.Deploy.Port }}/api') + '/{{ .Project.Auth.Entity | lowercase }}/register', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
            if (r.ok) { const d = await r.json(); if (d.token) $store.auth.login(d.token); else { success = 'Created! Redirecting...'; setTimeout(()=>location.href='login.html', 1500); } }
            else { const e = await r.json().catch(()=>({})); error = e.message || 'Registration failed'; }
          } catch(e) { error = e.message || 'Connection failed'; }
          submitting = false;
        })();
      " class="z-form-stacked">
        {{- range $.Project.Entities }}
        {{- if eq .Name $.Project.Auth.Entity }}
        {{- range .NonRelationFields }}
        {{- if and (not (.IsFeatureField)) (not .IsPrimary) (not .IsHidden) (not .IsArray) (not .IsJson) (ne .Name "email") (ne .Name "password") (ne .Name "Email") (ne .Name "Password") }}
        {{- if .HasValidation "required" }}
        <div class="margin-bottom">
          <label class="z-form-label z-form-label-required" style="font-weight: 500; font-size: 0.875rem;">{{ humanize .Name }}</label>
          <input type="{{ if .HasValidation "email" }}email{{ else if .HasValidation "url" }}url{{ else }}{{ inputType .DatabaseType }}{{ end }}" class="z-input" x-model="{{ .Name }}" placeholder="{{ humanize .Name }}" required style="border-radius: 0.5rem;" {{ if .HasValidation "min" }}{{ if .IsNumeric }}min="{{ .ValidationValue "min" }}"{{ else }}minlength="{{ .ValidationValue "min" }}"{{ end }}{{ end }} {{ if .HasValidation "max" }}{{ if .IsNumeric }}max="{{ .ValidationValue "max" }}"{{ else }}maxlength="{{ .ValidationValue "max" }}"{{ end }}{{ end }} />
        </div>
        {{- end }}
        {{- end }}{{- end }}
        {{- end }}{{- end }}
        <div class="margin-bottom">
          <label class="z-form-label z-form-label-required" style="font-weight: 500; font-size: 0.875rem;">Email</label>
          <input type="email" class="z-input" x-model="email" placeholder="admin@example.com" required autofocus style="border-radius: 0.5rem;" />
        </div>
        <div class="margin-bottom">
          <label class="z-form-label z-form-label-required" style="font-weight: 500; font-size: 0.875rem;">Password</label>
          <input type="password" class="z-input" x-model="password" placeholder="Min 8 characters" required minlength="8" style="border-radius: 0.5rem;" />
        </div>
        <div class="margin-bottom">
          <label class="z-form-label z-form-label-required" style="font-weight: 500; font-size: 0.875rem;">Confirm Password</label>
          <input type="password" class="z-input" x-model="confirm" placeholder="Repeat password" required style="border-radius: 0.5rem;" />
        </div>
        <div class="margin-bottom">
          <label class="z-toggle-switch-label" style="font-size: 0.875rem;"><input type="checkbox" class="z-toggle-switch" x-model="agree" required /><span>I agree to the terms</span></label>
        </div>
        <button type="submit" class="z-button btn-primary z-button-large" style="width: 100%; margin-top: 0.5rem; border-radius: 0.5rem;" :disabled="submitting || !agree">
          <span x-show="!submitting">Create Account</span><span x-show="submitting">Creating...</span>
        </button>
      </form>
      <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--z-border);">
        <p style="font-size: 0.8125rem; color: var(--z-muted-f); margin: 0;">Already have an account? <a href="login.html" style="color: var(--z-primary); text-decoration: none; font-weight: 500;">Sign in</a></p>
      </div>
    </div>
  </div>
  {{ template "scripts" }}
</body>
</html>
