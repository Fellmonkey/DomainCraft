<!doctype html>
<html lang="en">
<head>
  {{ template "head" (printf "Login - %s Admin" (.Project.Name | pascalcase)) }}
</head>
<body class="bg color" style="--bg: var(--z-bg); --color: var(--z-bg-f)">
  <div x-data="{ email: '', password: '', submitting: false, error: '' }"
    x-init="if ($store.auth.token) location.href = 'index.html'"
    style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--z-bg-muted);">
    <div class="login-card">
      <div style="text-align: center; margin-bottom: 2rem;">
        <div style="width: 48px; height: 48px; border-radius: 0.75rem; background: var(--z-primary); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <h1 style="font-size: 1.5rem; font-weight: 650; letter-spacing: -0.02em; margin: 0 0 0.375rem;">{{ .Project.Name | pascalcase }}</h1>
        <p style="font-size: 0.875rem; color: var(--z-muted-f); margin: 0;">Sign in to admin panel</p>
      </div>
      <template x-if="error"><div class="z-alert z-alert-danger" style="margin-bottom: 1.25rem; border-radius: 0.5rem;"><span x-text="error"></span></div></template>
      <form @submit.prevent="
        submitting = true; error = '';
        (async () => {
          try {
            const r = await fetch((window.API_BASE_URL || 'http://{{ .Project.Deploy.Domain }}:{{ .Project.Deploy.Port }}/api') + '/{{ .Project.Auth.Entity | lowercase }}/login', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({email, password}) });
            if (r.ok) { const d = await r.json(); $store.auth.login(d.token || d.accessToken); }
            else { const e = await r.json().catch(()=>({})); error = e.message || 'Login failed'; }
          } catch(e) { error = e.message || 'Connection failed'; }
          submitting = false;
        })();
      " class="z-form-stacked">
        <div class="margin-bottom">
          <label class="z-form-label z-form-label-required" style="font-weight: 500; font-size: 0.875rem;">Email</label>
          <input type="email" class="z-input" x-model="email" placeholder="admin@example.com" required autofocus style="border-radius: 0.5rem;" />
        </div>
        <div class="margin-bottom">
          <label class="z-form-label z-form-label-required" style="font-weight: 500; font-size: 0.875rem;">Password</label>
          <input type="password" class="z-input" x-model="password" placeholder="Enter password" required style="border-radius: 0.5rem;" />
        </div>
        <button type="submit" class="z-button btn-primary z-button-large" style="width: 100%; margin-top: 0.5rem; border-radius: 0.5rem;" :disabled="submitting">
          <span x-show="!submitting">Sign In</span><span x-show="submitting">Signing in...</span>
        </button>
      </form>
      <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--z-border);">
        <p style="font-size: 0.8125rem; color: var(--z-muted-f); margin: 0;">Don't have an account? <a href="register.html" style="color: var(--z-primary); text-decoration: none; font-weight: 500;">Register</a></p>
      </div>
    </div>
  </div>
  {{ template "scripts" }}
</body>
</html>
