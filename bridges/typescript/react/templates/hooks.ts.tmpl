// ---- optimistic update helpers ----

/** Extra options accepted by the generated mutation hooks. */
export interface OptimisticOptions {
  /** Apply an optimistic cache update and roll back on error (default true). */
  optimistic?: boolean;
}

type CacheSnapshot = [QueryKey, unknown][];

// Maps each item of a list result (offset or keyset/infinite) through `patch`,
// dropping the items `patch` returns as undefined. Used by optimistic updates
// and deletes to rewrite cached list rows in place without a refetch.
function mapListItems<T>(
  data: ListResult<T> | InfiniteData<ListResult<T>> | undefined,
  patch: (item: T) => T | undefined,
): ListResult<T> | InfiniteData<ListResult<T>> | undefined {
  if (!data) return data;
  const infinite = data as InfiniteData<ListResult<T>>;
  if (Array.isArray(infinite.pages)) {
    return {
      ...infinite,
      pages: infinite.pages.map((page) => ({
        ...page,
        items: page.items.map(patch).filter((item): item is T => item !== undefined),
      })),
    };
  }
  const page = data as ListResult<T>;
  return {
    ...page,
    items: page.items.map(patch).filter((item): item is T => item !== undefined),
  };
}

// Restores every query captured by an optimistic `onMutate` snapshot.
function restoreSnapshot(queryClient: QueryClient, snapshot: CacheSnapshot | undefined): void {
  if (!snapshot) return;
  for (const [key, data] of snapshot) queryClient.setQueryData(key, data);
}

// Apply a field→message map to a React Hook Form-style setter. Works with any
// form that exposes `setError(field, { type, message })`; wire it to
// `zodFieldErrors(zodError)` or `err.fieldErrors()`.
export function applyFieldErrors(
  errors: Record<string, string>,
  setError: (field: string, error: { type: string; message: string }) => void,
): void {
  for (const [field, message] of Object.entries(errors)) setError(field, { type: "server", message });
}

