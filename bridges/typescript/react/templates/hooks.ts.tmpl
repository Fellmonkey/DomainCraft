export const {{ camelcase $e.Name }}Keys = {
  all: ["{{ lower $e.NamePlural }}"] as const,
  list: (query: {{ $e.Name }}Query = {}) => ["{{ lower $e.NamePlural }}", "list", query] as const,
  detail: (id: {{ template "pkType" $e }}) => ["{{ lower $e.NamePlural }}", "detail", id] as const,
};

function optimisticUpdate{{ $e.Name }}(queryClient: QueryClient, id: {{ template "pkType" $e }}, patch: Partial<{{ $e.Name }}>): CacheSnapshot {
  const previous = queryClient.getQueriesData({ queryKey: {{ camelcase $e.Name }}Keys.all });
  queryClient.setQueryData({{ camelcase $e.Name }}Keys.detail(id), (old: {{ $e.Name }} | undefined) =>
    old ? { ...old, ...patch } : old,
  );
  queryClient.setQueriesData<ListResult<{{ $e.Name }}> | InfiniteData<ListResult<{{ $e.Name }}>>>(
    { queryKey: {{ camelcase $e.Name }}Keys.all, predicate: (q) => q.queryKey[1] === "list" },
    (old) => mapListItems(old, (item) => (item.{{ camelcase $e.PrimaryKey.Name }} === id ? { ...item, ...patch } : item)),
  );
  return previous;
}

function optimisticDelete{{ $e.Name }}(queryClient: QueryClient, id: {{ template "pkType" $e }}): CacheSnapshot {
  const previous = queryClient.getQueriesData({ queryKey: {{ camelcase $e.Name }}Keys.all });
  queryClient.setQueryData({{ camelcase $e.Name }}Keys.detail(id), undefined);
  queryClient.setQueriesData<ListResult<{{ $e.Name }}> | InfiniteData<ListResult<{{ $e.Name }}>>>(
    { queryKey: {{ camelcase $e.Name }}Keys.all, predicate: (q) => q.queryKey[1] === "list" },
    (old) => mapListItems(old, (item) => (item.{{ camelcase $e.PrimaryKey.Name }} === id ? undefined : item)),
  );
  return previous;
}

export function use{{ $e.NamePlural }}<I extends {{ $e.Name }}Include = never>(
  query: Omit<{{ $e.Name }}Query, "include"> & { include?: I[] } = {},
  options?: Omit<UseQueryOptions<ListResult<{{ $e.Name }}With<I>>>, "queryKey" | "queryFn">,
) {
  return useQuery({
    queryKey: {{ camelcase $e.Name }}Keys.list(query),
    queryFn: () => list{{ $e.NamePlural }}<I>(query),
    ...options,
  });
}

export function use{{ $e.Name }}(
  id: {{ template "pkType" $e }},
  options?: Omit<UseQueryOptions<{{ $e.Name }}>, "queryKey" | "queryFn">,
) {
  return useQuery({
    queryKey: {{ camelcase $e.Name }}Keys.detail(id),
    queryFn: () => get{{ $e.Name }}(id),
    ...options,
  });
}

// Create is NOT optimistic: the server assigns the primary key, so there is no
// stable id to write into the cache before the response arrives. The cache is
// invalidated on success instead.
export function useCreate{{ $e.Name }}(
  options?: Omit<UseMutationOptions<{{ $e.Name }}, Error, {{ $e.Name }}Create>, "mutationFn">,
) {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: (input: {{ $e.Name }}Create) => create{{ $e.Name }}(input),
    ...options,
    onSuccess: (...args) => {
      void queryClient.invalidateQueries({ queryKey: {{ camelcase $e.Name }}Keys.all });
{{- range $ref := $refs }}
      void queryClient.invalidateQueries({ queryKey: [{{ $ref }}] });
{{- end }}
      options?.onSuccess?.(...args);
    },
  });
}

export function useUpdate{{ $e.Name }}(
  id: {{ template "pkType" $e }},
  options?: Omit<UseMutationOptions<{{ $e.Name }}, Error, {{ $e.Name }}Update>, "mutationFn"> & OptimisticOptions,
) {
  const queryClient = useQueryClient();
  const optimistic = options?.optimistic !== false;
  return useMutation({
    mutationFn: (input: {{ $e.Name }}Update) => update{{ $e.Name }}(id, input),
    ...options,
    onMutate: async (input, mutationContext) => {
      const snapshot = optimistic ? optimisticUpdate{{ $e.Name }}(queryClient, id, input) : undefined;
      await options?.onMutate?.(input, mutationContext);
      return snapshot;
    },
    onError: (err, input, onMutateResult, mutationContext) => {
      restoreSnapshot(queryClient, onMutateResult);
      options?.onError?.(err, input, onMutateResult, mutationContext);
    },
    onSuccess: (...args) => {
      void queryClient.invalidateQueries({ queryKey: {{ camelcase $e.Name }}Keys.all });
{{- range $ref := $refs }}
      void queryClient.invalidateQueries({ queryKey: [{{ $ref }}] });
{{- end }}
      options?.onSuccess?.(...args);
    },
  });
}

