export function useInfinite{{ $e.NamePlural }}(
  query: Omit<{{ $e.Name }}Query, "cursor"> = {},
  options?: Omit<UseInfiniteQueryOptions<ListResult<{{ $e.Name }}>>, "queryKey" | "queryFn" | "initialPageParam" | "getNextPageParam">,
) {
  return useInfiniteQuery({
    queryKey: {{ camelcase $e.Name }}Keys.list(query),
    queryFn: ({ pageParam }) => list{{ $e.NamePlural }}({ ...query, cursor: pageParam as {{ template "pkType" $e }} | undefined }),
    initialPageParam: undefined as {{ template "pkType" $e }} | undefined,
    getNextPageParam: (last) => (last.nextCursor ?? undefined) as {{ template "pkType" $e }} | undefined,
    ...options,
  });
