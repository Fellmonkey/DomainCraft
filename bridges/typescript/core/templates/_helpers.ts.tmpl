{{- /* Shared named templates for the ts-core bridge. Loaded via bridge.yaml "helpers". */ -}}

{{- /* banner: auto-generated file header. */ -}}
{{ define "banner" }}/*
 * <auto-generated>
 * DomainCraft — GENERATED. DO NOT EDIT. Regenerated on every `domaincraft generate`.
 * Change the model in domain.yaml; this file is overwritten.
 * </auto-generated>
 */
{{ end }}

{{- /* readFieldLine: one member of the read-DTO interface for a field.
       Context: IRField. A to-many relation becomes `Target[]`, a to-one relation
       and a scalar become the FK id / scalar value (nullable -> `| null`). */ -}}
{{ define "readFieldLine" -}}
{{- $f := . -}}
{{- if and $f.IsRelation $f.IsMany }}
  {{ camelcase $f.Name }}?: {{ $f.RelationTarget }}[];
{{- else }}
  {{ camelcase $f.Name }}: {{ languageType $f.DatabaseType false }}{{ if $f.IsNullable }} | null{{ end }};
{{- end -}}
{{- end -}}

{{- /* zodElementType: the Zod schema for an array element / scalar db type.
       Context: dict "Type" (IR db type string), "Project". */ -}}
{{ define "zodElementType" -}}
{{- $t := .Type -}}
{{- $proj := .Project -}}
{{- if eq $t "uuid" }}z.string().uuid()
{{- else if or (eq $t "string") (eq $t "text") }}z.string()
{{- else if eq $t "int" }}z.number().int()
{{- else if eq $t "bigint" }}z.number().int()
{{- else if or (eq $t "float") (eq $t "decimal") }}z.number()
{{- else if eq $t "boolean" }}z.boolean()
{{- else if or (eq $t "date") (eq $t "datetime") }}z.string()
{{- else if or (eq $t "json") (eq $t "jsonb") }}z.unknown()
{{- else }}z.enum([{{ range $i, $v := ($proj.EnumValues $t) }}{{ if $i }}, {{ end }}{{ jsonValue $v.WireValue }}{{ end }}])
{{- end -}}
{{- end -}}

{{- /* zodField: the full Zod schema (base + validations) for a field.
       Context: dict "Field" (IRField), "Project". Validations come from the SAME
       source as the server's rules, so client and server can never drift. */ -}}
{{ define "zodField" -}}
{{- $f := .Field -}}
{{- $proj := .Project -}}
{{- if $f.IsArray }}z.array({{ template "zodElementType" (dict "Type" $f.ArrayElementType "Project" $proj) }})
{{- else if $f.IsUuid }}z.string().uuid()
{{- else if $f.IsText }}z.string(){{ if $f.HasValidation "email" }}.email(){{ end }}{{ if $f.HasValidation "url" }}.url(){{ end }}{{ if $f.HasValidation "ipv4" }}.ip({ version: "v4" }){{ end }}{{ if $f.HasValidation "min" }}.min({{ $f.ValidationValue "min" }}){{ end }}{{ if $f.HasValidation "max" }}.max({{ $f.ValidationValue "max" }}){{ end }}{{ if $f.HasValidation "regex" }}.regex(new RegExp({{ jsonValue ($f.ValidationValue "regex") }})){{ end }}
{{- else if $f.IsInteger }}z.number().int(){{ if $f.HasValidation "gte" }}.gte({{ $f.ValidationValue "gte" }}){{ end }}{{ if $f.HasValidation "gt" }}.gt({{ $f.ValidationValue "gt" }}){{ end }}{{ if $f.HasValidation "lte" }}.lte({{ $f.ValidationValue "lte" }}){{ end }}{{ if $f.HasValidation "lt" }}.lt({{ $f.ValidationValue "lt" }}){{ end }}
{{- else if $f.IsFloat }}z.number(){{ if $f.HasValidation "gte" }}.gte({{ $f.ValidationValue "gte" }}){{ end }}{{ if $f.HasValidation "gt" }}.gt({{ $f.ValidationValue "gt" }}){{ end }}{{ if $f.HasValidation "lte" }}.lte({{ $f.ValidationValue "lte" }}){{ end }}{{ if $f.HasValidation "lt" }}.lt({{ $f.ValidationValue "lt" }}){{ end }}
{{- else if $f.IsBoolean }}z.boolean()
{{- else if or $f.IsDate $f.IsDateTime }}z.string()
{{- else if $f.IsJson }}z.unknown()
{{- else if $f.IsEnum }}z.enum([{{ range $i, $v := ($proj.EnumValues $f.EnumTypeName) }}{{ if $i }}, {{ end }}{{ jsonValue $v.WireValue }}{{ end }}])
{{- else }}z.unknown()
{{- end -}}
{{- end -}}

{{- /* conditionType: the typed filter condition a field's type maps to.
       Context: dict "Field" (IRField). */ -}}
{{ define "conditionType" -}}
{{- $f := .Field -}}
{{- if $f.IsText }}TextCondition
{{- else if $f.IsBoolean }}BoolCondition
{{- else if or $f.IsDate $f.IsDateTime }}DateCondition
{{- else if or $f.IsInteger $f.IsFloat }}NumberCondition
{{- else }}IdCondition
{{- end -}}
{{- end -}}

{{- /* pkType: the TS type of the entity's primary key (string for uuid, number for int). */ -}}
{{ define "pkType" -}}
{{- if .PrimaryKey.IsInteger }}number{{ else }}string{{ end -}}
{{- end -}}
