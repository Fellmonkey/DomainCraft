            "name"
          ]
        },
        {
          "key": "idx-categories-slug-uniq",
          "type": "unique",
          "columns": [
            "slug"
          ]
        }
      ]
    },
    {
      "$id": "products",
      "$permissions": ["create(\"team:role-admin\")","read(\"any\")","update(\"team:role-admin\")","delete(\"team:role-admin\")"
      ],
      "databaseId": "main",
      "name": "Products",
      "enabled": true,
      "rowSecurity": false,
      "columns": [
        {
          "key": "createdAt",
          "type": "datetime",
          "required": false,
          "default": null
        },
        {
          "key": "deletedAt",
          "type": "datetime",
          "required": false,
          "default": null
        },
        {
          "key": "updatedAt",
          "type": "datetime",
          "required": false,
          "default": null
