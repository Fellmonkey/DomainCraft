    {
      "$id": "categories",
      "$permissions": ["create(\"team:role-admin\")","read(\"any\")","update(\"team:role-admin\")","delete(\"team:role-admin\")"
      ],
      "databaseId": "main",
      "name": "Categories",
      "enabled": true,
      "rowSecurity": false,
      "columns": [
        {
          "key": "createdAt",
          "type": "datetime",
          "required": false,
          "default": null
        },
        {
          "key": "updatedAt",
          "type": "datetime",
          "required": false,
          "default": null
        },
        {
          "key": "name",
          "type": "varchar",
          "required": true,
          "size": 100,
          "default": null
        },
        {
          "key": "slug",
          "type": "varchar",
          "required": true,
          "size": 255,
          "default": null
        },
        {
          "key": "isActive",
          "type": "boolean",
          "required": false,
          "default": true
        },
        {
          "key": "sortOrder",
          "type": "integer",
          "required": false,
          "default": 0
        }
      ],
