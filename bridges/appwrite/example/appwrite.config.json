        {
          "key": "status",
          "type": "string",
          "format": "enum",
          "required": false,
          "default": "DRAFT",
          "elements": ["DRAFT","PUBLISHED","ARCHIVED"
          ]
        },
        {
          "key": "categoryId",
          "type": "relationship",
          "required": false,
          "relatedTable": "categories",
          "relationType": "manyToOne",
          "twoWay": true,
          "twoWayKey": "products",
          "onDelete": "setNull"
        }
      ],
      "indexes": [
        {
          "key": "idx-products-0",
          "type": "key",
          "columns": ["status"
          ]
        }
      ]
    },
