{{- /* appwrite.config.json — generated by DomainCraft. Schema only: deploy with `appwrite push all`. */ -}}
{
  "projectId": "<PROJECT_ID>",
  "projectName": "{{ .Project.Name }}",
  "endpoint": "https://cloud.appwrite.io/v1",
  "settings": {
    "services": {
      "databases": true
{{- if .Project.HasAuth }},
      "users": true,
      "teams": true
{{- end }}
    },
    "protocols": {
      "rest": true
    }
{{- if .Project.HasAuth }},
    "auth": {
      "methods": {
        "email-password": true
      }
    }
{{- end }}
  },
  "tablesDB": [
    { "$id": "main", "name": "main", "enabled": true }
  ],
  "tables": [
{{- $auth := "" }}
{{- if .Project.HasAuth }}{{ $auth = .Project.Auth.Entity }}{{ end }}
{{- $firstTable := true }}
{{- range $entity := .Project.Entities }}
{{- if ne $entity.Name $auth }}
{{- if not $firstTable }},{{ end }}{{ $firstTable = false }}
    {
      "$id": "{{ template "entityID" $entity }}",
      "$permissions": [
{{- $firstP := true }}
{{- $rowSec := false }}
{{- if $entity.Permissions }}
{{- $rowSec = $entity.Permissions.HasOwnerToken }}
{{- end }}
{{- /* auth off or no permissions block → all four operations public (mirrors [AllowAnonymous]) */ -}}
{{- if or (not $.Project.HasAuth) (eq $entity.Permissions nil) }}
{{- if not $firstP }},{{ end }}{{ $firstP = false }}{{ template "permElement" (dict "op" "create" "role" "*" "mode" "table") }}
{{- if not $firstP }},{{ end }}{{ $firstP = false }}{{ template "permElement" (dict "op" "read" "role" "*" "mode" "table") }}
{{- if not $firstP }},{{ end }}{{ $firstP = false }}{{ template "permElement" (dict "op" "update" "role" "*" "mode" "table") }}
{{- if not $firstP }},{{ end }}{{ $firstP = false }}{{ template "permElement" (dict "op" "delete" "role" "*" "mode" "table") }}
{{- /* rowSecurity (any @Owner token) → table carries CREATE only; read/update/delete live on the row (helpers/permissions.js) */ -}}
{{- else if $rowSec }}
{{- if gt (len $entity.Permissions.Create) 0 }}{{ if not $firstP }},{{ end }}{{ $firstP = false }}{{ template "permOp" (dict "op" "create" "roles" $entity.Permissions.Create "mode" "table") }}{{ end }}
{{- /* no @Owner → every operation maps roles at table level; an empty list means deny */ -}}
{{- else }}
{{- if gt (len $entity.Permissions.Create) 0 }}{{ if not $firstP }},{{ end }}{{ $firstP = false }}{{ template "permOp" (dict "op" "create" "roles" $entity.Permissions.Create "mode" "table") }}{{ end }}
{{- if gt (len $entity.Permissions.Read) 0 }}{{ if not $firstP }},{{ end }}{{ $firstP = false }}{{ template "permOp" (dict "op" "read" "roles" $entity.Permissions.Read "mode" "table") }}{{ end }}
{{- if gt (len $entity.Permissions.Update) 0 }}{{ if not $firstP }},{{ end }}{{ $firstP = false }}{{ template "permOp" (dict "op" "update" "roles" $entity.Permissions.Update "mode" "table") }}{{ end }}
{{- if gt (len $entity.Permissions.Delete) 0 }}{{ if not $firstP }},{{ end }}{{ $firstP = false }}{{ template "permOp" (dict "op" "delete" "roles" $entity.Permissions.Delete "mode" "table") }}{{ end }}
{{- end }}
      ],
      "databaseId": "main",
      "name": "{{ $entity.NamePlural }}",
      "enabled": true,
      "rowSecurity": {{ jsonValue $rowSec }},
      "columns": [
{{- $firstCol := true }}
{{- range $f := $entity.Fields }}
{{- $isUuidPk := and $f.IsPrimary $f.IsUuid }}
{{- $relAuth := false }}
{{- if and $.Project.HasAuth (eq $f.RelationTarget $.Project.Auth.Entity) }}{{ $relAuth = true }}{{ end }}
{{- $relSelf := eq $f.RelationTarget $entity.Name }}
{{- $varcharRel := and $f.IsRelation (or $relAuth $relSelf) }}
{{- /* skip uuid PK (row $id) and real relationship fields (emitted below); auth/self relations become varchar(36) */ -}}
{{- if and (not $isUuidPk) (or (not $f.IsRelation) $varcharRel) }}
{{- if not $firstCol }},{{ end }}{{ $firstCol = false }}
{{- /* CLI 26 config contract: enum/email/url/ip are NOT column types — they are "string" + a format field (internal/schema/attributes.go). float/decimal write as "double". */ -}}
{{- $inner := $f.EnumTypeName }}
{{- $typeName := "varchar" }}
{{- $format := "" }}
{{- if $f.IsEnum }}{{ $typeName = "string" }}{{ $format = "enum" }}{{ else if $f.HasValidation "email" }}{{ $typeName = "string" }}{{ $format = "email" }}{{ else if $f.HasValidation "url" }}{{ $typeName = "string" }}{{ $format = "url" }}{{ else if $f.HasValidation "ipv4" }}{{ $typeName = "string" }}{{ $format = "ip" }}{{ else }}{{ $typeName = languageType $inner false }}{{ end }}
        {
          "key": "{{ camelcase $f.Name }}",
          "type": "{{ $typeName }}",
{{- if $format }}
          "format": "{{ $format }}",
{{- end }}
{{- /* feature-injected fields (audit/soft-delete/optimistic-lock) are nullable — Appwrite has no server-side auto-fill, the app writes them */ -}}
{{- $hasDefault := and $f.DefaultValue (not $f.DefaultIsFunc) (not $f.IsArray) }}
{{- $required := not $f.IsNullable }}
{{- if $f.IsFeatureField }}{{ $required = false }}{{ end }}
{{- /* Appwrite forbids a default on a required column — required+default becomes nullable with the default kept (the DB still fills it; documented loss) */ -}}
{{- if and $required $hasDefault }}{{ $required = false }}{{ end }}
          "required": {{ jsonValue $required }}
{{- $size := columnSize $inner }}
{{- if $size }}{{- range $f.Validations }}{{ if eq .Name "max" }}{{ $size = .Value }}{{ end }}{{ end }}{{ end }}
{{- if $size }},
          "size": {{ $size }}
{{- end }}
{{- if $f.IsArray }},
          "array": true
{{- end }}
{{- /* Appwrite forbids a default on a required column, so a real default only lands on optional non-array fields; the key itself is ALWAYS emitted (null fallback) because the CLI's attribute-update sends `required` + `default` together and the server rejects a PATCH without `default`. */ -}}
{{- $def := "" }}
{{- if and $hasDefault (not $required) }}{{ $def = $f.DefaultValue }}{{ end }}
{{- if and $def $f.IsDate (not (contains "T" $def)) }}{{ $def = printf "%sT00:00:00Z" $def }}{{ end }}
{{- /* numeric/boolean defaults come from the IR as strings — emit them raw, the API validates the type */ -}}
{{- $defRaw := or $f.IsNumeric $f.IsBoolean }},
          "default": {{ if and $def $defRaw }}{{ $def }}{{ else if $def }}{{ jsonValue $def }}{{ else }}null{{ end }}
{{- $min := "" }}
{{- $max := "" }}
{{- /* gte/gt/lte/lt only apply to numeric scalar fields */ -}}
{{- $isNum := $f.IsNumeric }}
{{- if $isNum }}
{{- range $f.Validations }}
{{- if eq .Name "gte" }}{{ $min = .Value }}{{ end }}
{{- if eq .Name "gt" }}{{ $min = .Value }}{{ end }}
{{- if eq .Name "lte" }}{{ $max = .Value }}{{ end }}
{{- if eq .Name "lt" }}{{ $max = .Value }}{{ end }}
{{- end }}
{{- end }}
{{- if $min }},
          "min": {{ $min }}
{{- end }}
{{- if $max }},
          "max": {{ $max }}
{{- end }}
{{- if $f.IsEnum }}
{{- $vals := index $.Project.Enums $inner }},
          "elements": [
{{- range $vi, $v := $vals }}{{ if gt $vi 0 }},{{ end }}{{ jsonValue $v }}{{ end }}
          ]
{{- end }}
{{- if $f.OldName }},
          "previousKey": "{{ camelcase $f.OldName }}"
{{- end }}
        }
{{- end }}
{{- end }}
{{- /* relationship columns (target is not auth, not self; reconciled 1:N collection side is skipped — the target's FK column represents it, twoWay creates the inverse) */ -}}
{{- range $rel := $entity.RelationsOut }}
{{- $relAuth := false }}
{{- if and $.Project.HasAuth (eq $rel.TargetEntity.Name $.Project.Auth.Entity) }}{{ $relAuth = true }}{{ end }}
{{- $relSkip := or $relAuth (eq $rel.TargetEntity.Name $entity.Name) }}
{{- $relSkip = or $relSkip (and $rel.IsMany (ne $rel.PairFieldName "")) }}
{{- if not $relSkip }}
{{- if not $firstCol }},{{ end }}{{ $firstCol = false }}
        {
          "key": "{{ camelcase $rel.FieldName }}",
          "type": "relationship",
          "required": {{ jsonValue (not $rel.IsNullable) }},
          "relatedTable": "{{ template "entityID" $rel.TargetEntity }}",
          "relationType": "{{ if $rel.IsMany }}manyToMany{{ else if eq $rel.RelationType "one-to-one" }}oneToOne{{ else }}manyToOne{{ end }}",
          "twoWay": true,
          "twoWayKey": "{{ camelcase $rel.InverseNavName }}"
{{- if $rel.OnDeleteBehavior }},
          "onDelete": "{{ deleteBehaviorName $rel.OnDeleteBehavior }}"
{{- end }}
        }
{{- end }}
{{- end }}
      ],
      "indexes": [
{{- $firstIdx := true }}
{{- range $ii, $idx := $entity.Indexes }}
{{- /* TablesDB refuses indexes on relationship columns — drop them from the index; skip the index entirely if it becomes empty (auth/self relations are varchar columns and stay indexable). */ -}}
{{- $cols := list }}
{{- range $c := $idx.Fields }}
{{- $f := $entity.FieldByName $c }}
{{- if $f }}
{{- $relAuth := and $.Project.HasAuth (eq $f.RelationTarget $.Project.Auth.Entity) }}
{{- $relSelf := eq $f.RelationTarget $entity.Name }}
{{- $isUuidPk := and $f.IsPrimary $f.IsUuid }}
{{- /* relationship columns and the uuid PK (row $id, no column) are not indexable */ -}}
{{- if not (or (and $f.IsRelation (not $relAuth) (not $relSelf)) $isUuidPk) }}
{{- $cols = append $cols $c }}
{{- end }}
{{- end }}
{{- end }}
{{- if gt (len $cols) 0 }}
{{- if not $firstIdx }},{{ end }}{{ $firstIdx = false }}
        {
          "key": "idx-{{ template "entityID" $entity }}-{{ $ii }}{{ if $idx.Unique }}-uniq{{ end }}",
          "type": {{ if $idx.Unique }}"unique"{{ else }}"key"{{ end }},
          "columns": [
{{- range $ci, $c := $cols }}{{ if gt $ci 0 }},{{ end }}"{{ camelcase $c }}"{{ end }}
          ]
{{- if $idx.Sort }},
          "orders": [
{{- range $si, $s := $idx.Sort }}{{ if gt $si 0 }},{{ end }}"{{ upper $s }}"{{ end }}
          ]
{{- end }}
        }
{{- end }}
{{- end }}
{{- /* field-level unique (incl. non-uuid PK) — skipped when a declared unique index already covers the single column */ -}}
{{- range $f := $entity.Fields }}
{{- $isUuidPk := and $f.IsPrimary $f.IsUuid }}
{{- $covered := false }}
{{- range $entity.Indexes }}{{ if and .Unique (eq (len .Fields) 1) (eq (index .Fields 0) $f.Name) }}{{ $covered = true }}{{ end }}{{ end }}
{{- $relAuth := and $.Project.HasAuth (eq $f.RelationTarget $.Project.Auth.Entity) }}
{{- $relSelf := eq $f.RelationTarget $entity.Name }}
{{- $realRel := and $f.IsRelation (not $relAuth) (not $relSelf) }}
{{- if and (or $f.IsUnique $f.IsPrimary) (not $isUuidPk) (not $covered) (not $realRel) }}
{{- if not $firstIdx }},{{ end }}{{ $firstIdx = false }}
        {
          "key": "idx-{{ template "entityID" $entity }}-{{ kebabcase $f.Name }}-uniq",
          "type": "unique",
          "columns": [
            "{{ camelcase $f.Name }}"
          ]
        }
{{- end }}
{{- end }}
      ]
    }
{{- end }}
{{- end }}
  ],
  "teams": [
{{- if .Project.HasAuth }}
{{- range $i, $role := .Project.Auth.Roles }}
{{- if gt $i 0 }},{{ end }}
    { "$id": "role-{{ lower $role }}", "name": "{{ $role }}" }
{{- end }}
{{- end }}
  ],
  "buckets": [],
  "functions": [],
  "sites": [],
  "webhooks": [],
  "topics": []
}

{{- define "entityID" -}}
{{- /* effective table $id: old_name pins the id so a rename becomes an in-place name update (§3.2 of the plan). old_name must be the exact previous singular entity name — any drift changes the id and becomes a delete+create. */ -}}
{{- if .OldName -}}{{ kebabcase (pluralize .OldName) }}{{- else -}}{{ kebabcase .NamePlural }}{{- end -}}
{{- end -}}

{{- define "permElement" -}}
{{- $op := .op -}}
{{- $role := .role -}}
{{- if eq $role "*" -}}
"{{ $op }}(\"any\")"
{{- else if hasPrefix "@" $role -}}
{{- if eq .mode "table" -}}
"{{ $op }}(\"users\")"
{{- else -}}
"{{ $op }}(\"user:{uid}\")"
{{- end -}}
{{- else -}}
"{{ $op }}(\"team:role-{{ lower $role }}\")"
{{- end -}}
{{- end -}}

{{- define "permOp" -}}
{{- range $i, $r := .roles }}{{ if gt $i 0 }},{{ end }}{{ template "permElement" (dict "op" $.op "role" $r "mode" $.mode) }}{{ end -}}
{{- end -}}
