#!/usr/bin/env node
// Generated by DomainCraft — seed rows through the Appwrite CLI.
// Uses your `appwrite` login session — no API keys required.
//
//   SEED_USER_ID=<userId> node scripts/seed.js
//
// SEED_USER_ID makes seeded rows of @Owner entities readable/writable by that
// user (row-level permissions). Without it, such rows are created without row
// permissions (visible only to team-role grants).
"use strict";

const { execFileSync, spawnSync } = require("child_process");
const fs = require("fs");
const path = require("path");

// The Appwrite CLI binary. Override with APPWRITE_CLI. On Windows the npm
// shim (appwrite.cmd) cannot be exec'd by Node, so the real exe is located
// under the npm prefix; a native appwrite.exe on PATH works as-is.
function cliPath() {
  if (process.env.APPWRITE_CLI) return process.env.APPWRITE_CLI;
  if (process.platform !== "win32") return "appwrite";
  const root = path.join(process.env.APPDATA || "", "npm", "node_modules", "appwrite-cli", "node_modules");
  try {
    for (const dir of fs.readdirSync(root)) {
      const bin = path.join(root, dir, "bin", "appwrite.exe");
      if (fs.existsSync(bin)) return bin;
    }
  } catch (e) {
    // not installed via npm — fall through to PATH lookup
  }
  return "appwrite";
}
const CLI = cliPath();

let rowPermissions = () => [];
try {
  ({ rowPermissions } = require("../helpers/permissions"));
} catch (e) {
  // no @Owner entities — helpers/permissions.js was not generated
}

const OWNER_UID = process.env.SEED_USER_ID || process.argv[2] || "";

// Seed rows come from the CORE's normalized SeedData (already coerced to native
// JS types), so this script only serializes them — it does not re-look-up field
// types or re-coerce numbers/booleans.
const ROWS = {
{{- range $entity := $.Project.Entities }}
{{- $se := $.SeedData.Entity $entity.Name }}
{{- if and $se (gt (len $se.Records) 0) }}
{{- /* table id = $id-pin for a renamed entity (mirror of define "entityID" in appwrite.config.json.tmpl — keep in sync) */ -}}
{{- $tableKey := kebabcase $entity.NamePlural }}
{{- if $entity.OldName }}{{ $tableKey = kebabcase (pluralize $entity.OldName) }}{{ end }}
  "{{ $tableKey }}": [
{{- range $ri, $row := $se.Records }}
{{- $pk := $entity.PrimaryKey }}
{{- $pkUuid := false }}
{{- if $pk }}{{ if $pk.IsUuid }}{{ $pkUuid = true }}{{ end }}{{ end }}
{{- $rowId := "" }}
{{- if $pkUuid }}{{ range $row.Fields }}{{ if and (eq .Field $pk.Name) (eq (kindOf .Value) "string") }}{{ $rowId = .Value }}{{ end }}{{ end }}{{ end }}
{{- $rowSec := false }}
{{- if $entity.Permissions }}
{{- $rowSec = $entity.Permissions.HasOwnerToken }}
{{- end }}
    {
{{- if $rowId }}
      "rowId": {{ jsonValue $rowId }},
{{- end }}
      "permissions": {{ if $rowSec }}OWNER_UID ? rowPermissions("{{ $tableKey }}", OWNER_UID) : []{{ else }}[]{{ end }},
      "data": {
{{- range $row.Fields }}
{{- /* uuid PK → rowId; non-uuid PK is an ordinary required column → keep it in data */ -}}
{{- if not (and $pkUuid (eq .Field $pk.Name)) }}
{{- $v := .Value }}
{{- /* date seeds normalize to full ISO so the datetime column accepts them */ -}}
{{- if eq .DBType "date" }}{{ if not (contains "T" $v) }}{{ $v = printf "%sT00:00:00Z" $v }}{{ end }}{{ end }}
        "{{ .Field }}": {{ jsonValue $v }},
{{- end }}
{{- end }}
      }
    }{{ if ne (add $ri 1) (len $se.Records) }},{{ end }}
{{- end }}
  ],
{{- end }}
{{- end }}
};

for (const [table, rows] of Object.entries(ROWS)) {
  for (const row of rows) {
    const args = ["tablesdb", "create-row", "--database-id", "main", "--table-id", table];
    // --row-id is mandatory; the uuid PK value becomes the row id, anything
    // else (int/string PK, no PK) gets a server-generated id.
    args.push("--row-id", row.rowId || "unique()");
    for (const perm of row.permissions) args.push("--permissions", perm);
    args.push("--data", JSON.stringify(row.data));

    // Idempotent: a row with an explicit id (uuid PK) that already exists is
    // skipped — re-running the seed must not fail on duplicates.
    if (row.rowId) {
      const exists = spawnSync(CLI, [
        "tablesdb", "get-row", "--database-id", "main", "--table-id", table,
        "--row-id", row.rowId,
      ], { encoding: "utf8" });
      if (exists.status === 0) {
        console.log(`Skipping ${table}/${row.rowId} (already exists).`);
        continue;
      }
    }

    execFileSync(CLI, args, { stdio: "inherit" });
  }
}
console.log("Seed complete.");
