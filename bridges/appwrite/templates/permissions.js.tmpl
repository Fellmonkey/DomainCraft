//     databases.createRow("main", "orders", { ... }, perms);
//
// "@Owner" grants are emitted as "user:{uid}" placeholders and substituted at
// runtime, so this file is pure data — no user IDs are baked in at generation.
"use strict";

const ROW_PERMISSIONS = {
{{- range $entity := $.Project.Entities }}
{{- $auth := "" }}
{{- if $.Project.HasAuth }}{{ $auth = $.Project.Auth.Entity }}{{ end }}
{{- if ne $entity.Name $auth }}
{{- $rowSec := false }}
{{- if $entity.Permissions }}
{{- $rowSec = $entity.Permissions.HasOwnerToken }}
{{- end }}
{{- if $rowSec }}
{{- /* table id = $id-pin for a renamed entity (mirror of define "entityID" in appwrite.config.json.tmpl — keep in sync) */ -}}
{{- $entityKey := kebabcase $entity.NamePlural }}
{{- if $entity.OldName }}{{ $entityKey = kebabcase (pluralize $entity.OldName) }}{{ end }}
  "{{ $entityKey }}": {
    "read": [
{{- range $i, $r := $entity.Permissions.Read }}{{ if gt $i 0 }},{{ end }}{{ template "permElement" (dict "op" "read" "role" $r) }}{{ end }}
    ],
    "update": [
{{- range $i, $r := $entity.Permissions.Update }}{{ if gt $i 0 }},{{ end }}{{ template "permElement" (dict "op" "update" "role" $r) }}{{ end }}
    ],
    "delete": [
{{- range $i, $r := $entity.Permissions.Delete }}{{ if gt $i 0 }},{{ end }}{{ template "permElement" (dict "op" "delete" "role" $r) }}{{ end }}
    ]
  },
{{- end }}
{{- end }}
{{- end }}
};

function rowPermissions(tableKey, userId) {
  const perms = ROW_PERMISSIONS[tableKey];
  if (!perms) return [];
  const result = [];
  for (const op of ["read", "update", "delete"]) {
    for (const perm of perms[op] || []) {
      result.push(perm.replace("{uid}", userId));
    }
  }
  return result;
}

module.exports = { rowPermissions };

{{- define "permElement" -}}
{{- $op := .op -}}
{{- $role := .role -}}
{{- if eq $role "*" -}}
"{{ $op }}(\"any\")"
{{- else if hasPrefix "@" $role -}}
"{{ $op }}(\"user:{uid}\")"
{{- else -}}
"{{ $op }}(\"team:role-{{ lower $role }}\")"
{{- end -}}
{{- end -}}
